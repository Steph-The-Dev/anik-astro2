# Kontaktdaten – werden nur beim Build gelesen und kodiert ausgegeben (nicht committen!)
CONTACT_EMAIL=name@example.com
CONTACT_PHONE=+41 00 000 00 00
# Zeilen mit | trennen
CONTACT_ADDRESS=Musterstrasse 1|1234 Ort|Schweiz
# Optional: Absenderadresse für Mails aus dem Kontaktformular (muss zur Domain auf dem Webspace passen).
# Standard: CONTACT_EMAIL
CONTACT_FORM_FROM=
