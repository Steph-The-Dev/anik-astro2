---
import { ClientRouter } from 'astro:transitions';

const { class: className, title = "Anik von Rohr | Systemische Beratung" } = Astro.props;

import Navbar from "@components/site/common/Navbar.astro";
import Footer from "@components/site/common/Footer.astro";

import "../styles/global.css";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
    <link
      href="https://cdn.jsdelivr.net/npm/swiffy-slider@1.6.0/dist/css/swiffy-slider.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <title>{title}</title>
    <ClientRouter />

        <!-- Matomo -->
<script>
declare global {
  interface Window {
    _paq?: any[]; // Or a more specific type if you know it
  }
}

  var _paq = window._paq = window._paq || [];
  /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
  (function() {
    var u="//schneidenundfaerben.de/matomo/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '1']);
    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
    g.async=true; g.src=u+'matomo.js';

    // Check if s and s.parentNode exist before trying to use insertBefore
    if (s && s.parentNode) {
      s.parentNode.insertBefore(g,s);
    } else {
      // Fallback: if no script tag is found, or it has no parent,
      // append to the head. This is a common practice for analytics scripts.
      // document.head is available in all modern browsers.
      // For older browsers, one might use document.getElementsByTagName('head')[0]
      const head = document.head || document.getElementsByTagName('head')[0];
      if (head) {
        head.appendChild(g);
      } else {
        // As an absolute last resort, though highly unlikely in a valid HTML document
        document.body.appendChild(g);
      }
    }
  })();
</script>
<!-- End Matomo Code -->
  </head>
  <body class={className}>
    <Navbar />
    <div>
      <slot />
    </div>
    <Footer />
  </body>
</html>
