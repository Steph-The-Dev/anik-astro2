---
import Navbar from "@components/site/common/Navbar.astro";
import Footer from "@components/site/common/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search engines (e.g. legal pages with contact data) */
  noindex?: boolean;
  class?: string;
}

const SITE_NAME = "Anik von Rohr | Systemische Beratung in Basel";
const {
  title,
  description = "Anik von Rohr – systemische Beraterin (DGSF) in Basel. Begleitung bei Krisen, Konflikten, Erziehungsfragen und beruflicher Neuorientierung.",
  noindex = false,
  class: className
} = Astro.props;

const pageTitle = title ? `${title} | Anik von Rohr` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#faf7f2" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="Anik von Rohr" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Matomo (self-hosted, cookieless) -->
    <script is:inline>
      // Wrapped in an IIFE: a global `const _paq` would break matomo.js, which reassigns window._paq
      (function () {
        const _paq = (window._paq = window._paq || []);
        _paq.push(["disableCookies"]);
        _paq.push(["trackPageView"]);
        _paq.push(["enableLinkTracking"]);
        const u = "https://schneidenundfaerben.de/matomo/";
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", "1"]);
        const g = document.createElement("script");
        g.async = true;
        g.src = u + "matomo.js";
        document.head.appendChild(g);
      })();
    </script>
  </head>
  <body class:list={["flex min-h-dvh flex-col", className]}>
    <a
      href="#main"
      class="bg-ink sr-only z-[60] rounded-full px-5 py-3 text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Zum Inhalt springen
    </a>
    <Navbar />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
