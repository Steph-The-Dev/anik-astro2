---
import LayoutSite from "@layouts/LayoutSite.astro";
import { Image } from "astro:assets";

import Window from "@images/Window_Gabriel Tenan.jpg";
import Teppich from "@images/teppich_engin_akyurt.webp";
import Pattern from "@images/Pattern_Daniel_Mc_Cullough.jpg";

const anliegen = [
  "schwierige Veränderungen im Leben besser bewältigen",
  "Krisen meistern und als Chance für Veränderung nutzen",
  "alte Muster reflektieren und im Hier und Jetzt neue Lösungsstrategien entwickeln",
  "Konflikte in Familie oder Beruf erkennen und bewältigen",
  "Unsicherheiten und Fragen in der Erziehung – und den damit verbundenen Stress",
  "berufliche Veränderungswünsche"
];

const ziele = [
  "Erweiterung von Handlungsmöglichkeiten",
  "Erwerb sozialer und psychologischer Kompetenzen",
  "Entwicklung neuer Perspektiven",
  "Bearbeitung konkreter Entscheidungsfragen",
  "Bewältigung persönlicher Krisen"
];

const imgClass = "size-full min-h-72 rounded-[var(--radius-card)] object-cover";
const sizes = "(min-width: 1024px) 50vw, 100vw";
---

<LayoutSite
  title="Systemische Beratung"
  description="Was bedeutet systemische Beratung? Anliegen und Ziele der systemischen Arbeit – Anik von Rohr, systemische Beraterin in Basel."
>
  <header class="container-page pt-12 pb-10 md:pt-20">
    <p class="eyebrow">Systemische Beratung</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold sm:text-5xl">Was bedeutet „systemisch“?</h1>
  </header>

  <div class="container-page grid gap-16 pb-20 md:gap-24 md:pb-28">
    <section class="grid items-stretch gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="text-ink-muted space-y-5 text-lg sm:text-xl">
        <p>
          Wir sind immer auch „Teil eines Ganzen“: Aus systemischer Sicht lassen sich unser Erleben und Verhalten nicht
          isoliert betrachten, sondern nur in der Dynamik wechselseitiger Beziehungen zu unserer Umwelt.
        </p>
        <p>Verändert sich ein Teil des Systems, kann das Auswirkungen auf das gesamte System haben.</p>
        <p>
          In der systemischen Beratung biete ich Ihnen fachliche Hilfe „von aussen“ und begleite Sie aufmerksam und
          kreativ dabei, individuelle, neue Wege zu finden.
        </p>
        <p class="text-ink font-bold">
          Systemisches Arbeiten ist dabei stets zukunfts-, lösungs- und ressourcenorientiert.
        </p>
      </div>
      <Image src={Teppich} alt="" width={1280} widths={[640, 960, 1280]} sizes={sizes} class={imgClass} />
    </section>

    <section aria-labelledby="anliegen" class="grid items-stretch gap-8 lg:grid-cols-2 lg:gap-12">
      <Image
        src={Pattern}
        alt=""
        width={1280}
        widths={[640, 960, 1280]}
        sizes={sizes}
        class:list={[imgClass, "order-2 lg:order-1"]}
      />
      <div class="bg-ink text-sand-50 rounded-[var(--radius-card)] p-8 sm:p-12 order-1 lg:order-2">
        <h2 id="anliegen" class="text-sand-50 text-2xl font-semibold sm:text-3xl">
          Anliegen für eine Beratung können sein:
        </h2>
        <ul class="mt-6 space-y-3 text-lg">
          {anliegen.map((item) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="bg-sand-300 mt-3 size-1.5 shrink-0 rounded-full" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="ziele" class="grid items-stretch gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="bg-sand-100 rounded-[var(--radius-card)] p-8 sm:p-12">
        <h2 id="ziele" class="text-2xl font-semibold sm:text-3xl">
          Übergeordnete Ziele systemischer Praxis
        </h2>
        <ol class="mt-6 grid gap-4">
          {ziele.map((item, i) => (
            <li class="flex items-baseline gap-4 text-lg">
              <span class="font-heading text-clay-600 text-2xl">{String(i + 1).padStart(2, "0")}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
      <Image src={Window} alt="" width={1280} widths={[640, 960, 1280]} sizes={sizes} class={imgClass} />
    </section>

    <section class="card flex flex-col items-start gap-6 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-12">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Sie möchten mehr erfahren?</h2>
        <p class="text-ink-muted mt-2 text-lg">Ein erstes Gespräch ist der einfachste Schritt.</p>
      </div>
      <a href="/#kontakt" class="btn-primary shrink-0">
        Kontakt aufnehmen
      </a>
    </section>
  </div>
</LayoutSite>
