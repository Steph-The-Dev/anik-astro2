---
import { Image } from "astro:assets";
import Pencil from "@images/pencil.webp";
import GirlWithRedHat from "@images/girl-with-red-hat.webp";
import Graffiti from "@images/graffiti.webp";
import Batman from "@images/batman.webp";

const topics = [
  {
    title: "Familie & Erziehung",
    image: Batman,
    questions: ["Sie haben eine lebhafte Familie und keine ruhige Minute?", "Sie machen sich Sorgen um Ihre Kinder?"]
  },
  {
    title: "Beruf & Ausbildung",
    image: Pencil,
    questions: ["Sie suchen eine Neuorientierung in Beruf oder Ausbildung?"]
  },
  {
    title: "Grenzen & Konflikte",
    image: GirlWithRedHat,
    questions: [
      "Sie möchten sich besser abgrenzen können?",
      "Sie stecken in einem Konflikt und wissen nicht, wie Sie damit umgehen sollen?"
    ]
  },
  {
    title: "Veränderung & Muster",
    image: Graffiti,
    questions: [
      "Sie möchten etwas in Ihrem Leben verändern?",
      "Sie geraten immer wieder in ähnliche Muster und würden das gern ändern?"
    ]
  }
];
---

<section aria-labelledby="topics-title" class="bg-sand-50 py-20 md:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Wobei ich Sie begleite</p>
      <h2 id="topics-title" class="mt-3 text-3xl font-semibold sm:text-4xl">
        Vielleicht erkennen Sie sich in einer dieser Fragen wieder?
      </h2>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {topics.map(({ title, image, questions }) => (
        <li class="card group flex flex-col overflow-hidden">
          <div class="aspect-[4/3] overflow-hidden">
            <Image
              src={image}
              alt=""
              width={640}
              widths={[400, 640]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              class="size-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-xl font-semibold">{title}</h3>
            <ul class="text-ink-muted mt-3 space-y-2">
              {questions.map((q) => (
                <li>{q}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 text-center">
      <a href="#kontakt" class="btn-primary">
        Unverbindlich anfragen
      </a>
    </div>
  </div>
</section>
