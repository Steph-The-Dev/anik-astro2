---
import { Image } from "astro:assets";
import AnikHero from "@images/AnikHero-H30A1875.webp";
---

<section aria-labelledby="hero-title" class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="bg-sand-100 absolute -top-40 -right-40 -z-10 size-[36rem] rounded-full opacity-70 blur-3xl"
  ></div>

  <div class="container-page grid items-center gap-10 py-12 md:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
    <div class="order-2 lg:order-1">
      <p class="eyebrow">Herzlich willkommen</p>
      <h1 id="hero-title" class="mt-4 text-4xl font-semibold sm:text-5xl xl:text-6xl">
        Neue Wege finden&nbsp;–
        <br class="hidden sm:block" />
        <em class="text-clay-600 font-normal">gemeinsam</em> und in Ihrem Tempo.
      </h1>
      <p class="text-ink-muted mt-6 max-w-xl text-lg sm:text-xl">
        Ich bin Anik von Rohr, systemische Beraterin (DGSF zertifiziert) in Basel. Ich begleite Sie bei Veränderungen,
        Krisen und Konflikten – in der Familie, im Beruf und im Alltag.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#kontakt" data-contact-dialog class="btn-primary">
          Kontakt aufnehmen
        </a>
        <a href="/systemische-beratung" class="btn-ghost">
          Was ist systemische Beratung?
        </a>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <div aria-hidden="true" class="bg-sage-200 absolute inset-0 translate-x-4 translate-y-4 rounded-[2rem]"></div>
        <Image
          src={AnikHero}
          alt="Porträt von Anik von Rohr"
          width={1280}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="relative aspect-[4/5] w-full rounded-[2rem] object-cover object-center shadow-[var(--shadow-soft)] sm:aspect-[5/4] lg:aspect-[4/5]"
        />
      </div>
    </div>
  </div>
</section>
