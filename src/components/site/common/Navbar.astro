---
import { Image } from "astro:assets";
import Logo from "@images/20241030-anik-logo.webp";

const links = [
  { href: "/systemische-beratung", label: "Systemische Beratung" },
  { href: "/ueber-mich", label: "Über mich" },
  { href: "/#kontakt", label: "Kontakt" }
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => href === path;
---

<header
  id="site-header"
  class="border-ink/5 bg-cream/80 sticky top-0 z-50 border-b backdrop-blur-md transition-transform duration-300"
>
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3" aria-label="Anik von Rohr – Startseite">
      <Image src={Logo} alt="" width={44} height={44} loading="eager" class="-rotate-45 drop-shadow-md" />
      <span class="font-heading text-lg leading-tight font-semibold sm:text-xl">
        Anik von Rohr
        <span class="font-body text-ink-muted block text-xs font-normal tracking-[0.14em] uppercase">
          Systemische Beratung
        </span>
      </span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-2">
        {links.map(({ href, label }) =>
          label === "Kontakt" ? (
            <li>
              <a href={href} class="btn-primary ml-2 px-5 py-2.5">
                {label}
              </a>
            </li>
          ) : (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? "page" : undefined}
                class="text-ink-muted hover:text-ink aria-[current=page]:text-ink aria-[current=page]:decoration-clay-600 rounded-full px-4 py-2 font-bold underline-offset-8 transition-colors aria-[current=page]:underline aria-[current=page]:decoration-2"
              >
                {label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <!-- Mobile menu: native popover API, no JS framework needed -->
    <button
      type="button"
      popovertarget="mobile-nav"
      class="hover:bg-sand-100 -mr-2 rounded-full p-2 md:hidden"
      aria-label="Menü öffnen"
    >
      <svg aria-hidden="true" class="size-7" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    popover
    aria-label="Mobile Navigation"
    class="bg-cream text-ink m-0 ml-auto h-dvh max-h-none w-[min(22rem,85vw)] p-6 shadow-2xl"
  >
    <div class="flex justify-end">
      <button
        type="button"
        popovertarget="mobile-nav"
        popovertargetaction="hide"
        class="hover:bg-sand-100 -mr-2 rounded-full p-2"
        aria-label="Menü schliessen"
      >
        <svg
          aria-hidden="true"
          class="size-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <ul class="mt-6 grid gap-2">
      <li>
        <a href="/" aria-current={isCurrent("/") ? "page" : undefined} class="mobile-link">
          Startseite
        </a>
      </li>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined} class="mobile-link">
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Close the mobile menu after picking a link (e.g. same-page anchor "#kontakt")
  const menu = document.getElementById("mobile-nav");
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.hidePopover()));

  // Hide header on scroll down, show on scroll up
  const header = document.getElementById("site-header");
  let last = window.scrollY;
  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY;
      const hide = y > 120 && y > last && !header?.contains(document.activeElement);
      header?.classList.toggle("-translate-y-full", hide);
      last = y;
    },
    { passive: true }
  );
</script>

<style>
  @reference "../../../styles/global.css";

  .mobile-link {
    @apply block rounded-2xl px-4 py-3 font-heading text-2xl hover:bg-sand-100 aria-[current=page]:bg-sand-100;
  }

  #mobile-nav {
    transition:
      translate 0.3s ease,
      opacity 0.3s ease,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
    translate: 100% 0;
    opacity: 0;
  }
  #mobile-nav:popover-open {
    translate: 0 0;
    opacity: 1;
  }
  @starting-style {
    #mobile-nav:popover-open {
      translate: 100% 0;
      opacity: 0;
    }
  }
  #mobile-nav::backdrop {
    background: rgb(47 38 30 / 0.35);
    backdrop-filter: blur(2px);
  }
</style>
